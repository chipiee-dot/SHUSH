# Copy this file to server/.env (same folder) and fill in the values. server/.env is git-ignored: never commit it.
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# Then run:  npm run doctor   (from the project folder) to check everything.

# ---- Database (SQL Server) --------------------------------------------------
DB_SERVER=localhost
# SQL Server Express usually installs as a NAMED instance (SQLEXPRESS): leave DB_PORT empty and set DB_INSTANCE.
# A default instance (MSSQLSERVER) uses a port: set DB_PORT=1433 and leave DB_INSTANCE empty.
# If a named instance will not connect, use its TCP port in DB_PORT and leave DB_INSTANCE empty.
DB_PORT=
DB_INSTANCE=SQLEXPRESS
DB_DATABASE=SHUSH
# Must match database/create_app_login.sql (login name and password).
DB_USER=shush_app
DB_PASSWORD=ChangeThis!Str0ngPassw0rd
# Local SQL Server usually has no certificate: keep trust on for localhost only.
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=true

# ---- Server -----------------------------------------------------------------
PORT=3001
# Long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If it is empty, everyone is signed out whenever the server restarts.
JWT_SECRET=
# Set to true once the site is served over HTTPS.
COOKIE_SECURE=false
# Set to true when running behind a reverse proxy.
TRUST_PROXY=false

# ---- Library ----------------------------------------------------------------
# The library's time offset from UTC in minutes (480 = Philippines, UTC+8).
LIBRARY_UTC_OFFSET_MINUTES=480
# Shared secret the hardware sends in the x-device-key header. Leave empty to keep the device API off.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DEVICE_API_KEY=
# A device that has not reported for this many seconds is shown as offline.
DEVICE_OFFLINE_SECONDS=120
