# Copy this file to .env and fill in the values.

# ---- Database (SQL Server) --------------------------------------------------
DB_SERVER=localhost
# Default instance: use the port. Named instance (e.g. SQLEXPRESS): set DB_INSTANCE and leave DB_PORT empty.
DB_PORT=1433
DB_INSTANCE=
DB_DATABASE=SHUSH
DB_USER=shush_app
DB_PASSWORD=ChangeThis!Str0ngPassw0rd
# Local SQL Server usually has no certificate: keep trust on for localhost only.
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=true

# ---- Server -----------------------------------------------------------------
PORT=3001
# Long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Set to true once the site is served over HTTPS.
COOKIE_SECURE=false
# Set to true when running behind a reverse proxy.
TRUST_PROXY=false

# ---- Library ----------------------------------------------------------------
# The library's time offset from UTC in minutes (480 = Philippines, UTC+8).
LIBRARY_UTC_OFFSET_MINUTES=480
# A device that has not reported for this many seconds is shown as offline.
DEVICE_OFFLINE_SECONDS=120
